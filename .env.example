# EV Charging Station Management System - Environment Configuration Template
# Copy this file to .env for local development and fill in your own secrets.
# NEVER commit .env with real credentials to Git.

FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace_with_64_char_random_hex_secret

# Option A: Standard MySQL Connection Parameters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ev_charging_db
# Optional path to CA certificate for SSL/TLS managed MySQL connections
MYSQL_SSL_CA=

# Option B: Managed Database URI (overrides MYSQL_* when provided)
# Retain MySQL 8.0+ format; NEVER attempt to connect MySQL using Supabase keys.
# Example: mysql+pymysql://user:password@host:port/ev_charging_db?ssl=true
DATABASE_URL=

# Web3Forms Contact & Enquiry Integration (processed server-side in Flask)
WEB3FORMS_ACCESS_KEY=

# Optional Supabase Configuration (Not used by active MySQL database layer)
# Publishable keys are never a substitute for server-side authorization or RLS.
# Never expose a service-role key in frontend templates/JS or commit real secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Razorpay Payment Integration (TEST MODE ONLY)
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Interactive Map Integration (Optional)
# When omitted, the interactive map automatically uses Leaflet.js + OpenStreetMap.
# If supplying a Google Maps JavaScript API key, restrict it in Google Cloud Console
# by HTTP referrer and to Maps JavaScript API + Places API only.
GOOGLE_MAPS_API_KEY=
